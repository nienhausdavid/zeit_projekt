 "doctype": "Print Format",
 "font": "Default",
 "html": "<style>\n  .sv-report { font-family: -apple-system, \"Segoe UI\", Helvetica, Arial, sans-serif; color: #1f2937; font-size: 12px; }\n  .sv-header { display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 3px solid #0f766e; padding-bottom: 10px; margin-bottom: 18px; }\n  .sv-header h1 { margin: 0; font-size: 20px; color: #0f766e; letter-spacing: .02em; }\n  .sv-header .sv-meta { text-align: right; font-size: 11px; color: #6b7280; line-height: 1.5; }\n  .sv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 28px; margin-bottom: 18px; }\n  .sv-field label { display: block; font-size: 9px; text-transform: uppercase; letter-spacing: .06em; color: #6b7280; margin-bottom: 1px; }\n  .sv-field .sv-value { font-size: 12.5px; }\n  .sv-section-title { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; color: #0f766e; border-bottom: 1px solid #d1d5db; padding-bottom: 3px; margin: 18px 0 8px; }\n  .sv-description { font-size: 12.5px; white-space: pre-wrap; line-height: 1.5; }\n  .sv-photos { display: flex; flex-wrap: wrap; gap: 10px; }\n  .sv-photo-card { width: 140px; }\n  .sv-photo-card img { width: 100%; height: 100px; object-fit: cover; border: 1px solid #d1d5db; border-radius: 4px; }\n  .sv-photo-card .sv-caption { font-size: 9.5px; color: #6b7280; margin-top: 3px; }\n  .sv-signature-row { display: flex; gap: 36px; align-items: flex-end; margin-top: 4px; }\n  .sv-signature-img { display: block; max-height: 65px; max-width: 240px; border-bottom: 1px solid #1f2937; padding-bottom: 4px; }\n  .sv-no-signature { font-size: 11px; color: #9ca3af; font-style: italic; padding-bottom: 4px; border-bottom: 1px solid #d1d5db; min-width: 240px; }\n  .sv-footer { margin-top: 24px; padding-top: 6px; border-top: 1px solid #e5e7eb; font-size: 9.5px; color: #9ca3af; display: flex; justify-content: space-between; }\n</style>\n<div class=\"sv-report\">\n\n  <div class=\"sv-header\">\n    <div><h1>{{ _(\"Site Visit Report\") }}</h1></div>\n    <div class=\"sv-meta\">\n      <b>{{ doc.name }}</b><br>\n      {{ frappe.utils.format_date(doc.date) }}\n    </div>\n  </div>\n\n  <div class=\"sv-grid\">\n    <div class=\"sv-field\">\n      <label>{{ _(\"Customer\") }}</label>\n      <div class=\"sv-value\">{{ doc.customer_name or doc.customer }}</div>\n    </div>\n    <div class=\"sv-field\">\n      <label>{{ _(\"Employee\") }}</label>\n      <div class=\"sv-value\">{{ doc.employee_name or doc.employee }}</div>\n    </div>\n    {% if doc.project %}\n    <div class=\"sv-field\">\n      <label>{{ _(\"Project\") }}</label>\n      <div class=\"sv-value\">{{ doc.project }}</div>\n    </div>\n    {% endif %}\n    {% if doc.sales_order %}\n    <div class=\"sv-field\">\n      <label>{{ _(\"Sales Order\") }}</label>\n      <div class=\"sv-value\">{{ doc.sales_order }}</div>\n    </div>\n    {% endif %}\n    <div class=\"sv-field\">\n      <label>{{ _(\"Activity Type\") }}</label>\n      <div class=\"sv-value\">{{ doc.activity_type }}</div>\n    </div>\n    <div class=\"sv-field\">\n      <label>{{ _(\"Time\") }}</label>\n      <div class=\"sv-value\">{{ frappe.utils.format_time(doc.from_time) }} &ndash; {{ frappe.utils.format_time(doc.to_time) }}</div>\n    </div>\n  </div>\n\n  {% if doc.description %}\n  <div class=\"sv-section-title\">{{ _(\"Work Performed\") }}</div>\n  <div class=\"sv-description\">{{ doc.description }}</div>\n  {% endif %}\n\n  {% if doc.photos %}\n  <div class=\"sv-section-title\">{{ _(\"Photos\") }}</div>\n  <div class=\"sv-photos\">\n    {% for row in doc.photos %}\n    <div class=\"sv-photo-card\">\n      <img src=\"{{ frappe.utils.get_url(row.photo) }}\">\n      {% if row.caption %}<div class=\"sv-caption\">{{ row.caption }}</div>{% endif %}\n    </div>\n    {% endfor %}\n  </div>\n  {% endif %}\n\n  <div class=\"sv-section-title\">{{ _(\"Customer Confirmation\") }}</div>\n  <div class=\"sv-signature-row\">\n    <div>\n      {% if doc.customer_signature %}\n      <img class=\"sv-signature-img\" src=\"{{ doc.customer_signature }}\">\n      {% else %}\n      <div class=\"sv-no-signature\">{{ _(\"No signature captured\") }}</div>\n      {% endif %}\n    </div>\n    <div class=\"sv-field\">\n      <label>{{ _(\"Signed by\") }}</label>\n      <div class=\"sv-value\">{{ doc.signee_name or \"&ndash;\" }}</div>\n    </div>\n  </div>\n\n  <div class=\"sv-footer\">\n    <span>{{ _(\"Timesheet\") }}: {{ doc.timesheet or \"&ndash;\" }}</span>\n    <span>{{ doc.company }}</span>\n  </div>\n\n</div>\n",
 "idx": 0,
 "modified": "2026-09-13 09:00:00.000000",
